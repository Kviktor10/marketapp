{
  "id": "com.mercadofinancas.app",
  "name": "Mercado & Finanças",
  "short_name": "Mercado+",
  "description": "Compras de supermercado e controle financeiro pessoal, com armazenamento local sem senha.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1712",
  "theme_color": "#0b1712",
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/launchericon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/launchericon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/GooglePlay-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
